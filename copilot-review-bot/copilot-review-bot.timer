[Unit]
Description=Run copilot-review-bot every 15 minutes

[Timer]
# First run shortly after boot, then every 15 minutes measured from the end of
# the previous run, so a slow run cannot pile up behind itself.
OnBootSec=2min
OnUnitActiveSec=15min

# Spread the polls out a little instead of hitting GitHub exactly on the
# quarter hour along with everybody else's cron.
RandomizedDelaySec=90

# Catch up once if the VM was down or suspended over a tick.
Persistent=true
AccuracySec=30s
Unit=copilot-review-bot.service

[Install]
WantedBy=timers.target
