[Unit]
Description=Request GitHub Copilot reviews on pull requests that are due one
Documentation=file:/opt/copilot-review-bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=copilot-bot
Group=copilot-bot

# GH_TOKEN=ghp_... and REPOS="owner/name owner/other" (mode 0600, owned by
# copilot-bot). Repos can also be listed on the ExecStart line below.
EnvironmentFile=/etc/copilot-review-bot/env
Environment=STATE_DIR=/var/lib/copilot-review-bot
Environment=HOME=/var/lib/copilot-review-bot

# Repos come from $REPOS in the EnvironmentFile above. To list them here
# instead, append them as arguments: ... .sh XRPLF/rippled XRPLF/clio
ExecStart=/opt/copilot-review-bot/copilot-review-bot.sh

# A run should never straddle the next timer tick; the script also holds its
# own flock, so a slow run is skipped rather than doubled up.
TimeoutStartSec=10min

# Outbound HTTPS to GitHub is all this needs.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
StateDirectory=copilot-review-bot
ReadWritePaths=/var/lib/copilot-review-bot

[Install]
WantedBy=multi-user.target
